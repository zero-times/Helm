    "@helm/database": "workspace:*",
    "@helm/execution": "workspace:*",
    "@helm/review": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
